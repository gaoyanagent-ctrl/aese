{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aese.local/schemas/plant-build-interactive.schema.json",
  "title": "M10 interactive plant planning contracts",
  "oneOf": [
    { "$ref": "#/$defs/facility_requirement" },
    { "$ref": "#/$defs/proposal_set" },
    { "$ref": "#/$defs/proposal_review" },
    { "$ref": "#/$defs/investigation_request" },
    { "$ref": "#/$defs/investigation_observation" },
    { "$ref": "#/$defs/investigation_confirmation" },
    { "$ref": "#/$defs/project_plan_option_set" }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "currency", "scale"],
      "properties": {
        "value": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "scale": { "type": "integer", "minimum": 0, "maximum": 6 }
      }
    },
    "financial_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_cash", "approved_budget", "cash_source_ref", "budget_source_ref", "snapshot_hash"],
      "properties": {
        "available_cash": { "$ref": "#/$defs/money" },
        "approved_budget": { "$ref": "#/$defs/money" },
        "cash_source_ref": { "type": "string", "minLength": 1 },
        "budget_source_ref": { "type": "string", "minLength": 1 },
        "snapshot_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]+$" }
      }
    },
    "facility_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "requirement_id", "tenant_id", "case_code", "legal_entity_code", "target_region", "facility_purpose", "minimum_area_m2", "minimum_electricity_kva", "target_available_at", "candidate_count", "allowed_option_types", "investment_request", "minimum_cash_reserve", "financial_constraint", "preferences", "revision", "revision_reason"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "requirement_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "case_code": { "type": "string", "minLength": 1 },
        "legal_entity_code": { "type": "string", "minLength": 1 },
        "target_region": { "type": "string", "minLength": 1 },
        "facility_purpose": { "type": "string", "minLength": 1 },
        "minimum_area_m2": { "type": "integer", "minimum": 1 },
        "minimum_electricity_kva": { "type": "integer", "minimum": 1 },
        "target_available_at": { "type": "string", "format": "date-time" },
        "candidate_count": { "type": "integer", "minimum": 2, "maximum": 8 },
        "allowed_option_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "investment_request": { "$ref": "#/$defs/money" },
        "minimum_cash_reserve": { "$ref": "#/$defs/money" },
        "financial_constraint": { "$ref": "#/$defs/financial_constraint" },
        "preferences": { "type": "array", "items": { "type": "string" } },
        "revision": { "type": "integer", "minimum": 1 },
        "revision_reason": { "type": "string", "minLength": 1 }
      }
    },
    "proposal_set": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "proposal_set_id", "requirement_id", "revision", "status", "proposals", "evidence"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "proposal_set_id": { "type": "string", "minLength": 1 },
        "requirement_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "const": "candidate_only" },
        "proposals": { "type": "array", "minItems": 2, "maxItems": 8 },
        "evidence": { "type": "object" }
      }
    },
    "proposal_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_set_id", "proposal_id", "action", "reason", "reviewed_by", "reviewed_at", "expected_revision"],
      "properties": {
        "proposal_set_id": { "type": "string", "minLength": 1 },
        "proposal_id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["adopt_for_investigation", "request_revision", "add_manual_option", "discard"] },
        "reason": { "type": "string", "minLength": 6 },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "expected_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "investigation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "investigation_request_id", "case_code", "proposal_set_id", "proposal_id", "expected_revision", "world_run_id", "scope", "requested_by", "requested_at", "status"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "investigation_request_id": { "type": "string", "minLength": 1 },
        "case_code": { "type": "string", "minLength": 1 },
        "proposal_set_id": { "type": "string", "minLength": 1 },
        "proposal_id": { "type": "string", "minLength": 1 },
        "expected_revision": { "type": "integer", "minimum": 1 },
        "world_run_id": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ownership", "commercial_quote", "available_area", "electricity_capacity", "available_date", "permit"] }
        },
        "requested_by": { "type": "string", "minLength": 1 },
        "requested_at": { "type": "string", "format": "date-time" },
        "status": { "const": "waiting_world" }
      }
    },
    "investigation_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "observation_id", "investigation_request_id", "proposal_id", "result", "ownership_status", "available_area_m2", "electricity_kva", "quoted_amount", "available_at", "permit_status", "evidence_refs", "notes", "external_actor_id", "observed_at"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "observation_id": { "type": "string", "minLength": 1 },
        "investigation_request_id": { "type": "string", "minLength": 1 },
        "proposal_id": { "type": "string", "minLength": 1 },
        "result": { "const": "completed" },
        "ownership_status": { "enum": ["verified", "conditional"] },
        "available_area_m2": { "type": "integer", "minimum": 1 },
        "electricity_kva": { "type": "integer", "minimum": 1 },
        "quoted_amount": { "$ref": "#/$defs/money" },
        "available_at": { "type": "string", "format": "date-time" },
        "permit_status": { "enum": ["eligible", "conditional"] },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string" },
        "external_actor_id": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "investigation_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "case_code", "requirement_id", "investigation_request_id", "action"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "case_code": { "type": "string", "minLength": 1 },
        "requirement_id": { "type": "string", "minLength": 1 },
        "investigation_request_id": { "type": "string", "minLength": 1 },
        "action": { "const": "accept_report" }
      }
    },
    "project_wbs_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wbs_code", "name", "phase", "sequence", "owner_position", "planned_start_at", "planned_finish_at", "budget_share_bps", "acceptance_criteria"],
      "properties": {
        "wbs_code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["design", "procurement", "construction", "commissioning"] },
        "sequence": { "type": "integer", "minimum": 1 },
        "owner_position": { "type": "string", "minLength": 1 },
        "planned_start_at": { "type": "string", "format": "date-time" },
        "planned_finish_at": { "type": "string", "format": "date-time" },
        "budget_share_bps": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "acceptance_criteria": { "type": "string", "minLength": 1 }
      }
    },
    "project_plan_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "title", "business_rationale", "project_name", "delivery_strategy", "budget_ceiling", "target_start_at", "target_ready_at", "wbs_items", "tradeoffs"],
      "properties": {
        "option_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "business_rationale": { "type": "string", "minLength": 1 },
        "project_name": { "type": "string", "minLength": 1 },
        "delivery_strategy": { "enum": ["design_bid_build", "design_build", "epcm"] },
        "budget_ceiling": { "$ref": "#/$defs/money" },
        "target_start_at": { "type": "string", "format": "date-time" },
        "target_ready_at": { "type": "string", "format": "date-time" },
        "wbs_items": { "type": "array", "minItems": 4, "maxItems": 12, "items": { "$ref": "#/$defs/project_wbs_item" } },
        "tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "project_plan_option_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "options", "evidence"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "options": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/project_plan_option" } },
        "evidence": { "type": "object" }
      }
    }
  }
}
