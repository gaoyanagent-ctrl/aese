# Local development only. Copy to .env and chmod 600 .env.
AESE_AUTH_MODE=iaos
MINMAX_API_KEY=
MINMAX_API_BASE=https://api.minimax.chat/v1
MINMAX_MODEL=MiniMax-M3

# Optional future embedding provider; not used by Genesis naming.
EMBEDDING_API_KEY=

# Only for isolated offline development. This disables IAOS Player authentication
# and is rejected unless AESE_LISTEN is 127.0.0.1/localhost.
# AESE_AUTH_MODE=local_dev
